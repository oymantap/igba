<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F12"
    tools:context=".MainActivity">

    <!-- Screen Emulator GBA (Layar Game Centered 3:2 Ratio) -->
    <com.rycl.igba.GbaView
        android:id="@+id/gba_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="3:2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ================= TOP CONTROLS (L / R / OPEN ROM) ================= -->

    <!-- Tombol L -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_l"
        android:layout_width="100dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="L"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#33FFFFFF"
        app:cornerRadius="12dp"
        app:strokeColor="#66FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tombol Open File ROM (Floating Button Tengah-Atas) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_open_rom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:contentDescription="Open ROM"
        android:src="@android:drawable/ic_menu_agenda"
        app:backgroundTint="#2563EB"
        app:fabCustomSize="44dp"
        app:tint="#FFFFFF"
        app:layout_constraintEnd_toStartOf="@id/btn_r"
        app:layout_constraintStart_toEndOf="@id/btn_l"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tombol R -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_r"
        android:layout_width="100dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:text="R"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#33FFFFFF"
        app:cornerRadius="12dp"
        app:strokeColor="#66FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ================= D-PAD AREA (KIRI BAHAH) ================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dpad_container"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- D-Pad UP -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_up"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="▲"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:backgroundTint="#40FFFFFF"
            app:cornerRadius="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- D-Pad LEFT -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_left"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="◀"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:backgroundTint="#40FFFFFF"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- D-Pad RIGHT -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_right"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:backgroundTint="#40FFFFFF"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- D-Pad DOWN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_down"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="▼"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:backgroundTint="#40FFFFFF"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= ACTION BUTTONS A/B (KANAN BAWAH) ================= -->

    <!-- Tombol B (Agak bawah di kiri A) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_b"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="96dp"
        android:layout_marginBottom="32dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="B"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:backgroundTint="#80EF4444"
        app:cornerRadius="32dp"
        app:strokeColor="#FFEF4444"
        app:strokeWidth="1.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tombol A (Di kanan atas B) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_a"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="72dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="A"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:backgroundTint="#8022C55E"
        app:cornerRadius="32dp"
        app:strokeColor="#FF22C55E"
        app:strokeWidth="1.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================= START & SELECT BUTTONS (TENGAH BAWAH) ================= -->

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_select"
            android:layout_width="72dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="SELECT"
            android:textColor="#D1D5DB"
            android:textSize="10sp"
            android:textStyle="bold"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="18dp"
            app:strokeColor="#40FFFFFF"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            android:layout_width="72dp"
            android:layout_height="36dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="START"
            android:textColor="#D1D5DB"
            android:textSize="10sp"
            android:textStyle="bold"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="18dp"
            app:strokeColor="#40FFFFFF"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
